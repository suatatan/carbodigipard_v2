---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TrainingCard from '../../../components/TrainingCard.astro';
import { getCollection } from 'astro:content';

const allTraining = await getCollection('tr-training');
const sortedTraining = allTraining.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout
  title="Eğitim Materyalleri"
  description="CARBODIGIPARD projesi kapsamında hazırlanmış eğitim modülleri, rehberler ve video materyalleri."
  lang="tr"
>
  <div class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Sayfa yolu">
        <a href="/tr">Ana Sayfa</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">Eğitim Materyalleri</span>
      </nav>
      <h1>Eğitim Materyalleri</h1>
      <p>Proje kapsamında hazırlanmış modüller, rehberler ve videolar</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="training-intro">
        <p>
          Bu sayfada CARBODIGIPARD projesi kapsamında çiftçiler, tarım danışmanları ve politika yapıcılar için hazırlanmış tüm eğitim materyallerine ulaşabilirsiniz.
          Materyaller ücretsiz olup herhangi bir kayıt gerekmeksizin kullanılabilir.
        </p>
      </div>

      {sortedTraining.length === 0 ? (
        <p class="empty-state">Henüz eğitim materyali bulunmamaktadır.</p>
      ) : (
        <div class="grid-3">
          {sortedTraining.map((item) => (
            <TrainingCard
              title={item.data.title}
              summary={item.data.summary}
              date={item.data.date}
              slug={item.id}
              category={item.data.category}
              image={item.data.image}
              videoUrl={item.data.videoUrl}
              duration={item.data.duration}
              lang="tr"
            />
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .training-intro {
    background: var(--color-surface);
    border-left: 4px solid var(--color-accent);
    padding: 1rem 1.25rem;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    margin-bottom: 2rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .training-intro p {
    margin-bottom: 0;
  }

  .empty-state {
    color: var(--color-text-muted);
    text-align: center;
    padding-block: 3rem;
  }
</style>
