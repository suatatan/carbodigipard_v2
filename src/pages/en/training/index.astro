---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TrainingCard from '../../../components/TrainingCard.astro';
import { getCollection } from 'astro:content';

const allTraining = await getCollection('en-training');
const sortedTraining = allTraining.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout
  title="Training Materials"
  description="Training modules, guides, and video materials prepared under the CARBODIGIPARD project."
  lang="en"
>
  <div class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/en">Home</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">Training Materials</span>
      </nav>
      <h1>Training Materials</h1>
      <p>Modules, guides, and videos prepared under the project</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="training-intro">
        <p>
          On this page you can access all training materials prepared for farmers, agricultural advisors, and policy makers under the CARBODIGIPARD project.
          Materials are free to use and require no registration.
        </p>
      </div>

      {sortedTraining.length === 0 ? (
        <p class="empty-state">No training materials available yet.</p>
      ) : (
        <div class="grid-3">
          {sortedTraining.map((item) => (
            <TrainingCard
              title={item.data.title}
              summary={item.data.summary}
              date={item.data.date}
              slug={item.id}
              category={item.data.category}
              image={item.data.image}
              videoUrl={item.data.videoUrl}
              duration={item.data.duration}
              lang="en"
            />
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .training-intro {
    background: var(--color-surface);
    border-left: 4px solid var(--color-accent);
    padding: 1rem 1.25rem;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    margin-bottom: 2rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .training-intro p {
    margin-bottom: 0;
  }

  .empty-state {
    color: var(--color-text-muted);
    text-align: center;
    padding-block: 3rem;
  }
</style>
