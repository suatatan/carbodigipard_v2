---
import partners from '../../data/partners.json';

interface Props {
  lang: 'tr' | 'en';
  title?: string;
}

const { lang, title } = Astro.props;
const heading = title ?? (lang === 'tr' ? 'Proje Ortakları' : 'Project Partners');
---

<section class="section section--alt partners-section">
  <div class="container">
    <div class="section-header">
      <h2>{heading}</h2>
      {lang === 'tr'
        ? <p>CARBODIGIPARD projesi, aşağıdaki ortak kuruluşların iş birliğiyle yürütülmektedir.</p>
        : <p>The CARBODIGIPARD project is carried out in collaboration with the following partner organisations.</p>
      }
    </div>
    <div class="partners-grid">
      {partners.map((partner) => (
        <a
          href={partner.website ?? '#'}
          target={partner.website ? '_blank' : undefined}
          rel={partner.website ? 'noopener noreferrer' : undefined}
          class="partner-card"
          title={partner.name}
        >
          {partner.logo
            ? (
              <img
                src={partner.logo}
                alt={partner.name}
                width="160"
                height="80"
                loading="lazy"
              />
            )
            : (
              <div class="partner-card__fallback">
                <span class="partner-card__abbr">{partner.abbreviation ?? partner.name.slice(0, 4)}</span>
              </div>
            )
          }
          <div class="partner-card__info">
            <span class="partner-card__name">{partner.name}</span>
            {partner.country && (
              <span class="partner-card__country">{partner.country}</span>
            )}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .partners-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }

  .partner-card {
    background: var(--color-white);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    padding: 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    transition: box-shadow 0.2s, transform 0.2s;
    text-align: center;
  }

  .partner-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .partner-card img {
    height: 60px;
    width: auto;
    max-width: 140px;
    object-fit: contain;
  }

  .partner-card__fallback {
    width: 80px;
    height: 60px;
    background: var(--color-surface-alt);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .partner-card__abbr {
    font-size: 1rem;
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: 0.05em;
  }

  .partner-card__info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .partner-card__name {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
  }

  .partner-card__country {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }
</style>
